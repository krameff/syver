#!/bin/bash

set -e
[ "$DEBUG" ] && set -x

# --- SYVER_*/GOSS_* env pairing -------------------------------------------
# Fold any SYVER_* variable into the GOSS_* name this script already uses, so
# the wrappers honour the same dual-prefix contract the binary does. A SYVER_*
# value wins only when it is set AND non-empty, so an exported-but-empty
# SYVER_X can never shadow a real GOSS_X -- this mirrors nonEmptyEnvVars() in
# cmd/syver/env_source.go. Assignment is deliberately not an export: it makes
# the result identical to the user having set the GOSS_* name themselves, and
# cannot newly leak a variable into a child process.
for _syver_var in FILES_PATH FILE VARS OPTS WAIT_OPTS SLEEP PATH FILES_STRATEGY; do
    _syver_src="SYVER_${_syver_var}"
    if [[ -n "${!_syver_src:-}" ]]; then
        printf -v "GOSS_${_syver_var}" '%s' "${!_syver_src}"
    fi
done
unset _syver_var _syver_src
# --------------------------------------------------------------------------

USAGE="USAGE: $(basename "$0") [run|edit] <docker-compose-service>"
GOSS_FILES_PATH="${GOSS_FILES_PATH:-.}"

# Container runtime (docker client calls)
CONTAINER_RUNTIME="${CONTAINER_RUNTIME:-docker}"
# Compose binary -- implemented but UNVERIFIED on this machine: no
# podman-compose / podman compose provider is installed here to test
# against (podman-only dev sandbox, no compose provider; the remote docker
# test host has only the v2 `docker compose` plugin, no `docker-compose` v1
# binary either). See FEAT-004 (.claude/tasks/FEAT-004-compose-v2-migration.md)
# for the actual v2 migration + verification against vagrant@172.16.20.167.
COMPOSE_BIN="${COMPOSE_BIN:-docker-compose}"

info() {
    echo -e "INFO: $*" >&2;
}
error() {
    echo -e "ERROR: $*" >&2;
    [[ -e "$service" ]] && $CONTAINER_RUNTIME logs "$service"
    exit 1;
}

cleanup() {
    set +e
    { kill "$log_pid" && wait "$log_pid"; } 2> /dev/null
    [ "$DEBUG" ] || rm -rf "$tmp_dir"
    if [[ -n "$service" ]]; then
        info "Stopping container"
        # NOTE: COMPOSE_BIN defaults to the standalone v1 `docker-compose`
        # binary, not the v2 `docker compose` plugin form -- see the
        # COMPOSE_BIN comment near the top of this file for why this half
        # is unverified and deferred to FEAT-004.
        $COMPOSE_BIN stop > /dev/null
    fi
}

# Echoes the first of the given basenames that exists under GOSS_FILES_PATH,
# or nothing. Mirrors resolveSpecPath() in cmd/syver/syver.go: syver-named
# files win over goss-named ones. Needed because `syver add` now defaults to
# writing ./syver.yaml, so gating the copy on goss.yaml alone would silently
# stage no spec at all for a project created with the current CLI.
first_existing(){
    local f
    for f in "$@"; do
        if [[ -e "${GOSS_FILES_PATH}/${f}" ]]; then
            printf '%s\n' "${GOSS_FILES_PATH}/${f}"
            return 0
        fi
    done
    return 1
}

run(){
    # Copy in syver
    cp "${GOSS_PATH}" "$tmp_dir/syver"
    chmod 755 "$tmp_dir/syver"
    # When GOSS_FILE is set it stays staged under its own basename, because the
    # exec below reads /syver/${GOSS_FILE} -- changing that would break the
    # explicit-override path. Only the unset case gains the syver.yaml probe,
    # and it stages as goss.yaml to match the exec's ${GOSS_FILE:-goss.yaml} default.
    local spec_src wait_src
    if [[ -n "${GOSS_FILE}" ]]; then
        spec_src="$(first_existing "${GOSS_FILE}")" || spec_src=""
        [[ -n "$spec_src" ]] && install -m ugo+rw "$spec_src" "$tmp_dir"
    else
        spec_src="$(first_existing syver.yaml syver.yml goss.yaml goss.yml)" || spec_src=""
        [[ -n "$spec_src" ]] && install -m ugo+rw "$spec_src" "$tmp_dir/goss.yaml"
    fi
    wait_src="$(first_existing syver_wait.yaml syver_wait.yml goss_wait.yaml goss_wait.yml)" || wait_src=""
    [[ -n "$wait_src" ]] && install -m ugo+rw "$wait_src" "$tmp_dir/goss_wait.yaml"
    [[ -n "${GOSS_VARS}" ]] && [[ -e "${GOSS_FILES_PATH}/${GOSS_VARS}" ]] && install -m ugo+rw "${GOSS_FILES_PATH}/${GOSS_VARS}" "$tmp_dir"

    # Switch between mount or cp files strategy
    GOSS_FILES_STRATEGY=${GOSS_FILES_STRATEGY:="mount"}
    case "$GOSS_FILES_STRATEGY" in
      mount)
        info "Starting $CONTAINER_RUNTIME container"
        # NOTE: COMPOSE_BIN call, unverified locally -- see the comment on
        # the stop call in cleanup() above.
        $COMPOSE_BIN run -d -T --name "$service" -v "$tmp_dir:/syver" --rm "${@:2}"
        ;;
      cp)
        info "Creating $CONTAINER_RUNTIME container"
        # NOTE: COMPOSE_BIN call, unverified locally -- see the comment on
        # the stop call in cleanup() above.
        $COMPOSE_BIN run -d -T --name "$service" --rm "${@:2}" > /dev/null
        info "Copy goss files into container"
        $CONTAINER_RUNTIME cp "$tmp_dir/." "$service:/syver"
        ;;
      *) error "Wrong goss files strategy used! Correct options are \"mount\" or \"cp\"."
    esac

    $CONTAINER_RUNTIME logs -f "$service" > "$tmp_dir/docker_output.log" 2>&1 &
    log_pid="$!"
    info "Container name: $service"
}

get_docker_file() {
    set +e
    if $CONTAINER_RUNTIME exec "$service" sh -c "test -e $1" > /dev/null; then
        mkdir -p "${GOSS_FILES_PATH}"
        info "Copied '$1' from container to '${GOSS_FILES_PATH}'"
        $CONTAINER_RUNTIME cp "$service:$1" "${GOSS_FILES_PATH}"
    fi
    set -e
}

# Main
tmp_dir=$(mktemp -d /tmp/tmp.XXXXXXXXXX)
chmod 777 "$tmp_dir"
# shellcheck disable=SC2154
trap 'ret=$?; cleanup; info "Test ran for a total of $SECONDS seconds"; exit $ret' EXIT
service="$2"

if [[ ! -f docker-compose.yaml && ! -f docker-compose.yml ]]; then
    echo "no docker-compose file found in ."
    exit 1
fi

state=$($CONTAINER_RUNTIME inspect --format '{{.State.Status}}' "$service" 2> /dev/null || true)
if [[ "$state" == running ]]; then
    $CONTAINER_RUNTIME rm -f "$service" > /dev/null
elif [[ "$state" == exited ]]; then
    $CONTAINER_RUNTIME rm "$service" > /dev/null
fi

# Auto-discovery prefers `syver` (the current binary name) and falls back
# to `goss` for older installs that haven't rebuilt/reinstalled yet -- a
# fresh syver-only PATH would otherwise never be found here, since `goss`
# no longer exists as a binary name post-rename.
GOSS_PATH="${GOSS_PATH:-$(command -v syver 2> /dev/null || command -v goss 2> /dev/null || true)}"
[[ "$GOSS_PATH" ]] || { error "Couldn't find a syver/goss installation, please set GOSS_PATH to it"; }
[[ "${GOSS_OPTS+x}" ]] || GOSS_OPTS="--color --format documentation"
[[ "${GOSS_WAIT_OPTS+x}" ]] || GOSS_WAIT_OPTS="-r 30s -s 1s > /dev/null"
GOSS_SLEEP="${GOSS_SLEEP:-0.2}"

[[ $CONTAINER_RUNTIME =~ ^(docker|podman)$ ]] || { error "Runtime must be one of docker or podman"; }

case "$1" in
    run)
        run "$@"
        [[ "$GOSS_SLEEP" ]] && { info "Sleeping for $GOSS_SLEEP"; sleep "$GOSS_SLEEP"; }
        # Gate on the same candidate set the copy step used, not on goss_wait.yaml
        # alone -- otherwise a staged syver_wait.yaml would never be waited on.
        if wait_found="$(first_existing syver_wait.yaml syver_wait.yml goss_wait.yaml goss_wait.yml)"; then
            info "Found $(basename "$wait_found"), waiting for it to pass before running tests"
            if [[ -z "${GOSS_VARS}" ]]; then
                if ! $CONTAINER_RUNTIME exec "$service" sh -c "/syver/syver -g /syver/goss_wait.yaml render | /syver/syver -g - validate $GOSS_WAIT_OPTS"; then
                    error "goss_wait.yaml never passed"
                fi
            else
                if ! $CONTAINER_RUNTIME exec "$service" sh -c "/syver/syver -g /syver/goss_wait.yaml --vars='/syver/${GOSS_VARS}' render | /syver/syver -g - validate $GOSS_WAIT_OPTS"; then
                    error "goss_wait.yaml never passed"
                fi
            fi
        fi
        info "Container health"
        if [ "true" != "$($CONTAINER_RUNTIME inspect -f '{{.State.Running}}' $service)" ]; then
            error "The container failed to start"
        fi
        info "Running Tests"
        if [[ -z "${GOSS_VARS}" ]]; then
            $CONTAINER_RUNTIME exec "$service" sh -c "/syver/syver -g /syver/${GOSS_FILE:-goss.yaml} render | /syver/syver -g - validate $GOSS_OPTS"
        else
            $CONTAINER_RUNTIME exec "$service" sh -c "/syver/syver -g /syver/${GOSS_FILE:-goss.yaml} --vars='/syver/${GOSS_VARS}' render | /syver/syver -g - validate $GOSS_OPTS"
        fi
        ;;
    edit)
        run "$@"
        info "Run syver add/autoadd to add resources"
        $CONTAINER_RUNTIME exec -it "$service" sh -c 'cd /syver; PATH="/syver:$PATH" exec sh'
        [[ -n "${GOSS_FILE}" ]] && get_docker_file "/syver/${GOSS_FILE}"
        get_docker_file "/syver/goss.yaml"
        get_docker_file "/syver/goss_wait.yaml"
        [[ -n "${GOSS_VARS}" ]] && get_docker_file "/syver/${GOSS_VARS}"
        ;;
    *)
        error "$USAGE"
esac
