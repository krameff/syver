#!/bin/bash

set -e
[ "$DEBUG" ] && set -x

# --- SYVER_*/GOSS_* env pairing -------------------------------------------
# Fold any SYVER_* variable into the GOSS_* name this script already uses, so
# the wrappers honour the same dual-prefix contract the binary does. A SYVER_*
# value wins only when it is set AND non-empty, so an exported-but-empty
# SYVER_X can never shadow a real GOSS_X -- this mirrors nonEmptyEnvVars() in
# cmd/syver/env_source.go. Assignment is deliberately not an export: it makes
# the result identical to the user having set the GOSS_* name themselves, and
# cannot newly leak a variable into a child process.
for _syver_var in FILES_PATH FILE VARS OPTS WAIT_OPTS SLEEP PATH FILES_STRATEGY; do
    _syver_src="SYVER_${_syver_var}"
    if [[ -n "${!_syver_src:-}" ]]; then
        printf -v "GOSS_${_syver_var}" '%s' "${!_syver_src}"
    fi
done
unset _syver_var _syver_src
# --------------------------------------------------------------------------

USAGE="USAGE: $(basename "$0") [run|edit] <compose-service>"
GOSS_FILES_PATH="${GOSS_FILES_PATH:-.}"

# Container runtime (docker client calls)
CONTAINER_RUNTIME="${CONTAINER_RUNTIME:-docker}"

info() {
    echo -e "INFO: $*" >&2;
}
error() {
    echo -e "ERROR: $*" >&2;
    [[ -e "$service" ]] && $CONTAINER_RUNTIME logs "$service"
    exit 1;
}

cleanup() {
    set +e
    { kill "$log_pid" && wait "$log_pid"; } 2> /dev/null
    [ "$DEBUG" ] || rm -rf "$tmp_parent"
    # COMPOSE_BIN may still be unresolved here if cleanup() fires (via the
    # EXIT trap) before Main ever reaches compose-provider detection --
    # e.g. the "no compose file found" gate exits first. Guard on it being
    # populated so that early-exit case doesn't try to run a bare "stop".
    if [[ -n "$service" && ${#COMPOSE_BIN[@]} -gt 0 ]]; then
        info "Stopping container"
        # Uses the v2 `docker compose` plugin by default, with a v1
        # `docker-compose` fallback -- see FEAT-004 for the migration and
        # the remote-host verification that confirmed it.
        "${COMPOSE_BIN[@]}" stop > /dev/null
    fi
}

# Echoes the first of the given basenames that exists under GOSS_FILES_PATH,
# or nothing. Mirrors resolveSpecPath() in cmd/syver/syver.go: syver-named
# files win over goss-named ones. Needed because `syver add` now defaults to
# writing ./syver.yaml, so gating the copy on goss.yaml alone would silently
# stage no spec at all for a project created with the current CLI.
first_existing(){
    local f
    for f in "$@"; do
        if [[ -e "${GOSS_FILES_PATH}/${f}" ]]; then
            printf '%s\n' "${GOSS_FILES_PATH}/${f}"
            return 0
        fi
    done
    return 1
}

run(){
    # Copy in goss
    cp "${GOSS_PATH}" "$tmp_dir/goss"
    chmod 755 "$tmp_dir/goss"
    # When GOSS_FILE is set it stays staged under its own basename, because the
    # exec below reads /goss/${GOSS_FILE} -- changing that would break the
    # explicit-override path. Only the unset case gains the syver.yaml probe,
    # and it stages as goss.yaml to match the exec's ${GOSS_FILE:-goss.yaml} default.
    # spec_src and wait_src are global: `edit` copies back to them.
    if [[ -n "${GOSS_FILE}" ]]; then
        spec_src="$(first_existing "${GOSS_FILE}")" || spec_src=""
        [[ -n "$spec_src" ]] && install -m ugo+rw "$spec_src" "$tmp_dir"
    else
        spec_src="$(first_existing syver.yaml syver.yml goss.yaml goss.yml)" || spec_src=""
        [[ -n "$spec_src" ]] && install -m ugo+rw "$spec_src" "$tmp_dir/goss.yaml"
    fi
    wait_src="$(first_existing syver_wait.yaml syver_wait.yml goss_wait.yaml goss_wait.yml)" || wait_src=""
    [[ -n "$wait_src" ]] && install -m ugo+rw "$wait_src" "$tmp_dir/goss_wait.yaml"
    [[ -n "${GOSS_VARS}" ]] && [[ -e "${GOSS_FILES_PATH}/${GOSS_VARS}" ]] && install -m ugo+rw "${GOSS_FILES_PATH}/${GOSS_VARS}" "$tmp_dir"

    # Switch between mount or cp files strategy
    GOSS_FILES_STRATEGY=${GOSS_FILES_STRATEGY:="mount"}
    case "$GOSS_FILES_STRATEGY" in
      mount)
        info "Starting $CONTAINER_RUNTIME container"
        # Uses the v2 `docker compose` plugin by default, with a v1
        # `docker-compose` fallback -- see FEAT-004 for the migration and
        # the remote-host verification that confirmed it.
        "${COMPOSE_BIN[@]}" run -d -T --name "$service" -v "$tmp_dir:/goss" --rm "${@:2}"
        ;;
      cp)
        info "Creating $CONTAINER_RUNTIME container"
        # Uses the v2 `docker compose` plugin by default, with a v1
        # `docker-compose` fallback -- see FEAT-004 for the migration and
        # the remote-host verification that confirmed it.
        "${COMPOSE_BIN[@]}" run -d -T --name "$service" --rm "${@:2}" > /dev/null
        info "Copy goss files into container"
        $CONTAINER_RUNTIME cp "$tmp_dir/." "$service:/goss"
        ;;
      *) error "Wrong goss files strategy used! Correct options are \"mount\" or \"cp\"."
    esac

    $CONTAINER_RUNTIME logs -f "$service" > "$tmp_dir/docker_output.log" 2>&1 &
    log_pid="$!"
    info "Container name: $service"
}

# get_docker_file SRC [DEST] copies SRC out of the container to DEST, by
# default GOSS_FILES_PATH. It returns 1 when SRC does not exist.
get_docker_file() {
    local dst="${2:-${GOSS_FILES_PATH}}" rc=1
    set +e
    if $CONTAINER_RUNTIME exec "$service" sh -c "test -e $1" > /dev/null 2>&1; then
        mkdir -p "${GOSS_FILES_PATH}"
        info "Copied '$1' from container to '$dst'"
        $CONTAINER_RUNTIME cp "$service:$1" "$dst"
        rc=0
    fi
    set -e
    return $rc
}

# copy_back DEST NAME... copies the first NAME that exists in the container's
# /goss back to DEST, or to its own name under GOSS_FILES_PATH when DEST is
# empty. The names are given in resolveSpecPath() order, so the file picked is
# the one `goss add` wrote: the staged goss.yaml, or a syver.yaml it created
# because nothing was staged.
copy_back(){
    local dst=$1 f
    shift
    for f in "$@"; do
        get_docker_file "/goss/${f}" "${dst:-${GOSS_FILES_PATH}/${f}}" && return 0
    done
    return 0
}

# Main
# mktemp -d creates the directory 0700, and that is exactly what is wanted on
# the outer directory: it is what stops other local users reaching the contents.
# The inner directory is the one bind-mounted (or copied) into the container,
# and it has to be world-writable because the container process may run as any
# UID. Nesting the permissive directory inside a private one gives the container
# the access it needs without publishing the contents to every user on the host.
#
# That matters here specifically because this directory holds the syver binary
# that the container is about to execute: a world-writable directory directly
# under /tmp let any local user swap that binary between staging and startup.
tmp_parent=$(mktemp -d /tmp/tmp.XXXXXXXXXX)
tmp_dir="$tmp_parent/goss"
mkdir "$tmp_dir"
chmod 777 "$tmp_dir"
# shellcheck disable=SC2154
trap 'ret=$?; cleanup; info "Test ran for a total of $SECONDS seconds"; exit $ret' EXIT
service="$2"

if [[ ! -f compose.yaml && ! -f compose.yml && ! -f docker-compose.yaml && ! -f docker-compose.yml ]]; then
    echo "no compose file found in ."
    exit 1
fi

# Compose provider: prefer the v2 plugin ("docker compose"), fall back to
# the legacy v1 binary ("docker-compose") if the plugin is absent. Two
# words, so this is a bash array, not a scalar -- see extras/dcsyver/dcsyver
# (FEAT-004) for why.
#
# Deliberately placed after the compose-file existence check above (not
# before service="$2" as first sketched) so a directory with neither a
# compose file nor a compose provider gets the friendlier "no compose file
# found" message instead of a provider-detection error -- see FEAT-004
# Assumptions & Open Questions for the ordering trade-off.
if [ -n "${COMPOSE_BIN:-}" ]; then
    # shellcheck disable=SC2206
    read -ra COMPOSE_BIN <<< "$COMPOSE_BIN"
elif docker compose version > /dev/null 2>&1; then
    COMPOSE_BIN=(docker compose)
elif command -v docker-compose > /dev/null 2>&1; then
    COMPOSE_BIN=(docker-compose)
else
    error "No Docker Compose provider found (checked the 'docker compose' plugin and the legacy 'docker-compose' binary). Install one, or set COMPOSE_BIN explicitly."
fi

state=$($CONTAINER_RUNTIME inspect --format '{{.State.Status}}' "$service" 2> /dev/null || true)
if [[ "$state" == running ]]; then
    $CONTAINER_RUNTIME rm -f "$service" > /dev/null
elif [[ "$state" == exited ]]; then
    $CONTAINER_RUNTIME rm "$service" > /dev/null
fi

# Auto-discovery prefers `syver` (the current binary name) and falls back
# to `goss` for older installs that haven't rebuilt/reinstalled yet -- a
# fresh syver-only PATH would otherwise never be found here, since `goss`
# no longer exists as a binary name post-rename.
GOSS_PATH="${GOSS_PATH:-$(command -v syver 2> /dev/null || command -v goss 2> /dev/null || true)}"
[[ "$GOSS_PATH" ]] || { error "Couldn't find a syver/goss installation, please set GOSS_PATH to it"; }
[[ "${GOSS_OPTS+x}" ]] || GOSS_OPTS="--color --format documentation"
[[ "${GOSS_WAIT_OPTS+x}" ]] || GOSS_WAIT_OPTS="-r 30s -s 1s > /dev/null"
GOSS_SLEEP="${GOSS_SLEEP:-0.2}"

[[ $CONTAINER_RUNTIME =~ ^(docker|podman)$ ]] || { error "Runtime must be one of docker or podman"; }

case "$1" in
    run)
        run "$@"
        [[ "$GOSS_SLEEP" ]] && { info "Sleeping for $GOSS_SLEEP"; sleep "$GOSS_SLEEP"; }
        # Gate on the same candidate set the copy step used, not on goss_wait.yaml
        # alone -- otherwise a staged syver_wait.yaml would never be waited on.
        if wait_found="$(first_existing syver_wait.yaml syver_wait.yml goss_wait.yaml goss_wait.yml)"; then
            info "Found $(basename "$wait_found"), waiting for it to pass before running tests"
            if [[ -z "${GOSS_VARS}" ]]; then
                if ! $CONTAINER_RUNTIME exec "$service" sh -c "/goss/goss -g /goss/goss_wait.yaml render | /goss/goss -g - validate $GOSS_WAIT_OPTS"; then
                    error "goss_wait.yaml never passed"
                fi
            else
                if ! $CONTAINER_RUNTIME exec "$service" sh -c "/goss/goss -g /goss/goss_wait.yaml --vars='/goss/${GOSS_VARS}' render | /goss/goss -g - validate $GOSS_WAIT_OPTS"; then
                    error "goss_wait.yaml never passed"
                fi
            fi
        fi
        info "Container health"
        if [ "true" != "$($CONTAINER_RUNTIME inspect -f '{{.State.Running}}' $service)" ]; then
            error "The container failed to start"
        fi
        info "Running Tests"
        if [[ -z "${GOSS_VARS}" ]]; then
            $CONTAINER_RUNTIME exec "$service" sh -c "/goss/goss -g /goss/${GOSS_FILE:-goss.yaml} render | /goss/goss -g - validate $GOSS_OPTS"
        else
            $CONTAINER_RUNTIME exec "$service" sh -c "/goss/goss -g /goss/${GOSS_FILE:-goss.yaml} --vars='/goss/${GOSS_VARS}' render | /goss/goss -g - validate $GOSS_OPTS"
        fi
        ;;
    edit)
        run "$@"
        info "Run goss add/autoadd to add resources"
        $CONTAINER_RUNTIME exec -it "$service" sh -c 'cd /goss; PATH="/goss:$PATH" exec sh'
        # An explicit GOSS_FILE is staged under its own name, so it comes back
        # under it. Otherwise the spec goes back to the host file it was staged
        # from, so a syver.yaml is not shadowed by a new goss.yaml holding the edits.
        if [[ -n "${GOSS_FILE}" ]]; then
            get_docker_file "/goss/${GOSS_FILE}" "${spec_src:-${GOSS_FILES_PATH}/${GOSS_FILE}}" || true
        else
            copy_back "$spec_src" syver.yaml syver.yml goss.yaml goss.yml
        fi
        copy_back "$wait_src" syver_wait.yaml syver_wait.yml goss_wait.yaml goss_wait.yml
        [[ -n "${GOSS_VARS}" ]] && get_docker_file "/goss/${GOSS_VARS}" || true
        ;;
    *)
        error "$USAGE"
esac
